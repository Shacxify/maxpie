# Discord bot token: Developer Portal > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=

# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: models to try in order, comma-separated
# Default: gemini-flash-latest,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest
GEMINI_MODELS=

# Set to true if your server has members under 18 ("bowl break" becomes "snack break")
MAX_PG_MODE=false
