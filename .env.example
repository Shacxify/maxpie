# Discord bot token: Developer Portal > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=

# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override, defaults to gemini-flash-latest
GEMINI_MODEL=

# Set to true if your server has members under 18 ("bowl break" becomes "snack break")
MAX_PG_MODE=false
