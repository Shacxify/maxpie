# Discord bot token: Developer Portal > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=

# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional override, defaults to gpt-5.4-mini
OPENAI_MODEL=

# Set to true if your server has members under 18 ("bowl break" becomes "snack break")
MAX_PG_MODE=false
