# Discord: https://discord.com/developers/applications > your app
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Only needed to run `npm run register`, never by the deployed function
DISCORD_BOT_TOKEN=
# Optional: register commands on one server for instant updates while testing
DISCORD_GUILD_ID=

# Claude API: https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-opus-5-5
CLAUDE_MODEL=

# Optional: recent sightings near the user's location (free key: https://ebird.org/api/keygen)
EBIRD_API_KEY=
# Optional: song and call links (free key from your xeno-canto account page)
XENO_CANTO_API_KEY=

# Set to true if your server has members under 18 ("bowl break" becomes "snack break")
MAX_PG_MODE=false
