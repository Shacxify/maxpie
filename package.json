{
  "name": "maxpie",
  "version": "0.2.0",
  "private": true,
  "description": "Maxpie: a Discord bot that IDs animals from photos when you @mention it, voiced by field ornithologist Max Liske",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "openai": "^7.39.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
